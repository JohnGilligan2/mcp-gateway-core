# mcp-gateway, local development. Copy to .env (gitignored) and edit, or export
# these in your shell. Every value below is a placeholder.

# ---------------------------------------------------------------------------
# Local bench, auth OFF
# ---------------------------------------------------------------------------
# Auth off means NO identity reaches any upstream, so the upstreams must also
# be running with auth off. Never expose a gateway in this mode.
MCP_AUTH_ENABLED=false
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Tool search collapses the catalog to search_tools + call_tool. Set false to
# reproduce the flat aggregation measurement, which costs MORE context than
# connecting to the servers separately.
GATEWAY_TOOL_SEARCH=true
GATEWAY_TOOL_SEARCH_MAX_RESULTS=8

GATEWAY_UPSTREAMS=inventory,docs

GW_UP_INVENTORY_URL=http://127.0.0.1:8101/mcp
GW_UP_INVENTORY_IDENTIFIER_URI=https://inventory-mcp.example.com/mcp
GW_UP_INVENTORY_GROUP=Inventory-MCP-Users

GW_UP_DOCS_URL=http://127.0.0.1:8102/mcp
GW_UP_DOCS_IDENTIFIER_URI=https://docs-mcp.example.com/mcp
GW_UP_DOCS_GROUP=Docs-MCP-Users

# ---------------------------------------------------------------------------
# Entra. Set MCP_AUTH_ENABLED=true and fill these in.
# ---------------------------------------------------------------------------
# MCP_BASE_URL=https://mcp-gateway.example.com
# MCP_PUBLIC_URL=https://mcp-gateway.example.com
# ENTRA_TENANT_ID=<your tenant id>
# ENTRA_CLIENT_ID=<the gateway app's client id>
#
# MUST be the /mcp URL, never api://<client-id>. Wrong = AADSTS9010010.
# ENTRA_IDENTIFIER_URI=https://mcp-gateway.example.com/mcp
# ENTRA_SCOPE_NAME=access_as_user
# ENTRA_REQUIRED_SCOPES=access_as_user
# ENTRA_ADVERTISE_OFFLINE_ACCESS=true
#
# On-Behalf-Of needs a confidential client. Keep it out of git. No '$' in it.
# ENTRA_GATEWAY_CLIENT_SECRET=
